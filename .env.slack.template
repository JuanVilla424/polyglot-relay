# Copy to .env and configure (Slack deployment)
# NEVER commit .env to git

# Bot User OAuth Token (xoxb-...): api.slack.com/apps -> your app ->
# OAuth & Permissions, after installing the app to the workspace
SLACK_BOT_TOKEN=your_slack_bot_token_here

# App-level token (xapp-...) with the connections:write scope, from
# Basic Information -> App-Level Tokens -- required for Socket Mode
SLACK_APP_TOKEN=your_slack_app_token_here

# Internal Docker network address of the libretranslate service (language detection only)
LIBRETRANSLATE_URL=http://libretranslate:5000

# Internal Docker network address of the nllb translation service
NLLB_URL=http://nllb:8000

# Fallback target language for the Translate shortcut when the requester
# never ran /polyglot-lang (ISO 639-1 code)
DEFAULT_TARGET_LANGUAGE=en

# Optional: Slack channel ID (C...) where language-command activity gets
# reported (successes and rejected attempts). Leave unset to disable. Open
# the channel details in Slack -- the ID is at the bottom of the About tab.
LOG_CHANNEL_ID=
