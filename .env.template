# Copy to .env and configure
# NEVER commit .env to git

# Discord Developer Portal -> your application -> Bot -> Reset Token
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Internal Docker network address of the libretranslate service (language detection only)
LIBRETRANSLATE_URL=http://libretranslate:5000

# Internal Docker network address of the nllb translation service
NLLB_URL=http://nllb:8000

# Optional: Discord channel ID where language-command activity gets reported
# (successes and rejected attempts). Leave unset to disable. Enable Developer
# Mode in Discord, right-click the channel, "Copy Channel ID".
LOG_CHANNEL_ID=

# Optional: Discord channel ID where event cancellations are announced with
# @everyone. Leave unset to disable. The bot needs the "Mention @everyone,
# @here, and All Roles" permission in that channel, or the ping won't notify
# anyone even though the message still sends.
ANNOUNCEMENTS_CHANNEL_ID=

# Optional, all four required together to enable the "verification" module
# (/polyglot-modules enable verification): a member posts a photo in
# VERIFY_CHANNEL_ID, and when someone holding one of VERIFY_APPROVER_ROLE_IDS
# reacts with the checkmark, the bot grants VERIFIED_ROLE_ID + MEMBER_ROLE_ID
# to whoever posted it. Enable Developer Mode, right-click a channel/role to
# copy its ID; VERIFY_APPROVER_ROLE_IDS is a comma-separated list of role IDs.
#
# Two things the bot needs before this can work at all, neither settable from
# here: (1) the bot's own role must be positioned ABOVE both VERIFIED_ROLE_ID
# and MEMBER_ROLE_ID in Server Settings -> Roles -- Discord never lets a bot
# assign a role above its own; (2) the bot must be invited with the "Manage
# Roles" permission (reopen the invite URL with it added, see Getting Started
# above -- doesn't duplicate the bot).
VERIFY_CHANNEL_ID=
VERIFIED_ROLE_ID=
MEMBER_ROLE_ID=
VERIFY_APPROVER_ROLE_IDS=
