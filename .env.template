# Copy to .env and configure
# NEVER commit .env to git

# Discord Developer Portal -> your application -> Bot -> Reset Token
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Internal Docker network address of the libretranslate service (language detection only)
LIBRETRANSLATE_URL=http://libretranslate:5000

# Internal Docker network address of the nllb translation service
NLLB_URL=http://nllb:8000

# Optional: Discord channel ID where language-command activity gets reported
# (successes and rejected attempts). Leave unset to disable. Enable Developer
# Mode in Discord, right-click the channel, "Copy Channel ID".
LOG_CHANNEL_ID=
